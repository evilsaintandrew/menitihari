# Required by the application at runtime.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection used by Prisma. Keep the pool small on the launch VPS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menitihari?schema=public&connection_limit=5&pool_timeout=10

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional isolated PostgreSQL database used by database integration tests.
TEST_DATABASE_URL=

# Optional Sentry error reporting. Keep the client DSN public by design.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
